# ==============================================================================
# OCT9 Luxury Ethnic Wear - Production .htaccess (Apache & LiteSpeed)
# Single Page Application (SPA) Routing, HTTPS Enforcement, Caching & Security
# ==============================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# ------------------------------------------------------------------------------
# 1. Direct ErrorDocument Fallback (Instantly catches any 404 on Apache / LiteSpeed)
# ------------------------------------------------------------------------------
ErrorDocument 404 /index.html

# ------------------------------------------------------------------------------
# 2. Rewrite Engine & SSL Enforcement
# (Keep RewriteEngine at root level without <IfModule> wrapper for LiteSpeed compatibility)
# ------------------------------------------------------------------------------
RewriteEngine On
RewriteBase /

# Force HTTPS redirect if requested via plain HTTP (handles reverse proxy headers like Cloudflare/cPanel)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Stop rewriting if index.html is directly requested
RewriteRule ^index\.html$ - [L]

# ------------------------------------------------------------------------------
# 3. Backend API & Uploads Proxy / Fallback
# ------------------------------------------------------------------------------
# If mod_proxy is enabled on the server, reverse-proxy API requests seamlessly
<IfModule mod_proxy.c>
    RewriteRule ^api/?(.*)$ https://backend.oct9.in/api/$1 [P,L]
    RewriteRule ^uploads/?(.*)$ https://backend.oct9.in/uploads/$1 [P,L]
</IfModule>

# If mod_proxy is not enabled, transparently redirect API calls to backend
<IfModule !mod_proxy.c>
    RewriteRule ^api/?(.*)$ https://backend.oct9.in/api/$1 [R=307,L]
    RewriteRule ^uploads/?(.*)$ https://backend.oct9.in/uploads/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. SEO Sitemaps, Robots & AI Discoverability Fallback (if physical file missing)
# ------------------------------------------------------------------------------
# Allow .well-known directly without rewriting to index.html
RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ https://backend.oct9.in/sitemap.xml [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^robots\.txt$ https://backend.oct9.in/robots.txt [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^llms\.txt$ https://backend.oct9.in/llms.txt [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^llms-full\.txt$ https://backend.oct9.in/llms-full.txt [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ai-catalog\.json$ https://backend.oct9.in/ai-catalog.json [R=301,L]

# ------------------------------------------------------------------------------
# 5. SPA Route Resolution (Exclude physical assets, directories, and symlinks)
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.*)$ /index.html [L,QSA]

# ------------------------------------------------------------------------------
# 6. HTTP Security Headers (OWASP Defense-in-Depth)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # HTML Caching: Always revalidate index.html so user gets latest deployments immediately
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </Files>

    # Static Assets Caching: Cache immutable hashed assets for 1 year
    <FilesMatch "\.(js|css|webp|avif|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # PWA Web Manifest CORS & Caching
    <Files "manifest.json">
        Header set Access-Control-Allow-Origin "*"
        Header set Content-Type "application/manifest+json"
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=86400"
    </Files>

    # SEO & Agent Discoverability Caching
    <FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt|llms-full\.txt|ai-catalog\.json|ard\.json)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=86400"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 7. Gzip / Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 8. MIME Types Configuration
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest .json
</IfModule>
