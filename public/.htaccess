# ----------------------------------------------------------------------
# LiteSpeed Web Server - SPA Routing & 404 Fallback
# (DO NOT WRAP REWRITE RULES IN <IfModule mod_rewrite.c> ON LITESPEED)
# ----------------------------------------------------------------------
Options -Indexes +ExecCGI
AddHandler cgi-script .cgi .pl

# 1. Direct ErrorDocument Fallback (Instantly catches any 404 on LiteSpeed)
ErrorDocument 404 /index.html

# 2. LiteSpeed Rewrite Engine
RewriteEngine On
RewriteBase /

# Stop rewriting if index.html is directly requested
RewriteRule ^index\.html$ - [L]

# Direct fallback for SEO files to backend if not found locally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ https://backend.oct9.in/sitemap.xml [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^robots\.txt$ https://backend.oct9.in/robots.txt [R=301,L]

# Exclude existing physical files, directories, and symlinks
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l

# Rewrite all other paths (e.g. /product/..., /cart, /orders) to /index.html
RewriteRule ^(.*)$ /index.html [L,QSA]
